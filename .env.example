# ---- Network ----------------------------------------------------------------
HEDERA_NETWORK=hedera:testnet
FACILITATOR_URL=https://api.testnet.blocky402.com

# ---- Privy (the only secrets here; no Hedera private keys anywhere) ---------
# Create an app at https://dashboard.privy.io, then App settings → API keys.
# Wallets live in Privy and sign inside its TEE; this project never sees a key.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: a different API base, and an authorization signature when wallets are owned by an
# authorization key rather than the app itself.
# PRIVY_API_URL=https://api.privy.io
# PRIVY_AUTHORIZATION_SIGNATURE=

# ---- Generated by `bun run setup:privy` -------------------------------------
# One Privy wallet per role, with the Hedera account it keys.
OPERATOR_WALLET_ID=
OPERATOR_ACCOUNT_ID=
AGENT_WALLET_ID=
AGENT_ACCOUNT_ID=
PROVIDER_1_WALLET_ID=
PROVIDER_1_ACCOUNT_ID=
PROVIDER_2_WALLET_ID=
PROVIDER_2_ACCOUNT_ID=
PROVIDER_3_WALLET_ID=
PROVIDER_3_ACCOUNT_ID=

# HBAR given to each account when it is created
OPERATOR_INITIAL_HBAR=200
AGENT_INITIAL_HBAR=50
PROVIDER_INITIAL_HBAR=5

# HTS tokens every account is associated with (comma-separated). Default: testnet USDC.
ASSOCIATE_TOKEN_IDS=0.0.429274

# ---- Generated by `bun run setup:topics` ------------------------------------
# HCS topic where providers publish their registrations
REGISTRY_TOPIC_ID=
# HCS topic where agents record every finished job's payments
AUDIT_TOPIC_ID=

# ---- Generated by `bun run setup:token` -------------------------------------
# DeComp Compute Credit, an HTS token agents can pay in instead of HBAR
COMPUTE_TOKEN_ID=

# ---- Local services ---------------------------------------------------------
JOB_RUNNER_URL=http://127.0.0.1:8100
# Provider the agent uses when no registry topic is configured (or with --provider)
PROVIDER_URL=http://127.0.0.1:4021
# Endpoint a provider advertises in the registry (defaults to http://127.0.0.1:<PORT>)
# PUBLIC_URL=

# ---- Metering ---------------------------------------------------------------
# Jobs are paid in ticks of TICK_SECONDS of GPU wall-clock time;
# PROVIDER_OFFERS prices are tinybars per second, e.g. benchmark:2000000,mandelbrot:3000000
TICK_SECONDS=5
# A provider kills a job this many seconds after its paid time runs out
TICK_GRACE_SECONDS=5
# Optional prices in COMPUTE_TOKEN_ID's smallest unit per second; must cover every PROVIDER_OFFERS job type
# PROVIDER_TOKEN_OFFERS=benchmark:5,mandelbrot:8
