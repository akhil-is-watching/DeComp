{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // The connector's browser-bundled login page and provider-node's Electron renderer both need DOM
  // lib, which conflicts with the Bun/Node stream types server code relies on (scripts/dev.ts's
  // ReadableStream async iteration). Each has its own tsconfig and is checked separately — see
  // apps/connector/tsconfig.json and apps/provider-node/tsconfig.renderer.json.
  "exclude": ["apps/connector/src/login.tsx", "apps/provider-node/src/renderer"]
}
