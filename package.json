{
  "name": "decomp",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "check:phase0": "bun scripts/check-phase0.ts",
    "setup:privy": "bun scripts/setup-privy-wallets.ts",
    "setup:topics": "bun scripts/create-hcs-topics.ts",
    "setup:token": "bun scripts/mint-compute-token.ts",
    "setup:runner": "cd services/job-runner && uv venv --python 3.12 .venv && uv pip install --python .venv/bin/python -r requirements.txt",
    "dev:runner": "cd services/job-runner && .venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8100",
    "dev:provider": "bun apps/provider/src/index.ts",
    "agent": "bun apps/agent/src/index.ts",
    "validate:phase1": "bun scripts/validate-phase1.ts",
    "validate:phase2": "bun scripts/validate-phase2.ts",
    "validate:phase3": "bun scripts/validate-phase3.ts",
    "validate:phase4": "bun scripts/validate-phase4.ts",
    "audit:reconstruct": "bun scripts/reconstruct-audit.ts",
    "connector": "bun apps/connector/src/index.ts",
    "dev:connector": "bun --hot apps/connector/src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && cd apps/connector && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.85.0",
    "@x402/core": "2.25.0",
    "@x402/fetch": "2.25.0",
    "@x402/hedera": "2.25.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
